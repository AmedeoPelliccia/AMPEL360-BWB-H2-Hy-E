#!/bin/bash
# AMPEL360 Constitutional Compliance Pre-commit Hook
# Enforces Digital Constitution requirements at commit time

set -e

echo "⚖️  AMPEL360 Constitutional Compliance Check"
echo "=============================================="

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;36m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files to check"
    exit 0
fi

echo ""
echo "📋 Checking staged files for constitutional compliance..."

# Check 1: Verify labor reabsorption tracking in commit message (for automation changes)
echo ""
echo "1️⃣  Labor Reabsorption Check"
echo "   Checking for automation/process changes..."

AUTOMATION_INDICATORS=(
    "automat"
    "ai "
    "ml "
    "neural"
    "model"
    "pipeline"
    "workflow"
    "process"
    "script"
)

COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
LABOR_SENSITIVE=false

# Check if any staged files might affect labor
for file in $STAGED_FILES; do
    FILE_LOWER=$(echo "$file" | tr '[:upper:]' '[:lower:]')
    
    for indicator in "${AUTOMATION_INDICATORS[@]}"; do
        if [[ "$FILE_LOWER" == *"$indicator"* ]]; then
            LABOR_SENSITIVE=true
            break 2
        fi
    done
    
    # Check file contents for automation keywords
    if [ -f "$file" ]; then
        CONTENT=$(git diff --cached "$file" | grep "^+" | tr '[:upper:]' '[:lower:]' || true)
        for indicator in "${AUTOMATION_INDICATORS[@]}"; do
            if [[ "$CONTENT" == *"$indicator"* ]]; then
                LABOR_SENSITIVE=true
                break 2
            fi
        done
    fi
done

if [ "$LABOR_SENSITIVE" = true ]; then
    echo -e "   ${YELLOW}⚠️  Detected automation-related changes${NC}"
    echo "   Reminder: If this introduces labor displacement, ensure:"
    echo "   • Labor reabsorption pathway is documented"
    echo "   • Net displacement is <= 0 (or governance override provided)"
    echo "   • Transition plan is included"
    echo ""
    echo "   Reference: GOVERNANCE.md Article 1"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "   ${GREEN}✅ No automation-related changes detected${NC}"
fi

# Check 2: Verify constitutional hash presence in model/config files
echo ""
echo "2️⃣  Constitutional Hash Check"
echo "   Checking model/config files for constitutional compliance markers..."

MODEL_CONFIG_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yaml|yml|json|toml|py|tf|h5|onnx|pkl)$' || true)

if [ -n "$MODEL_CONFIG_FILES" ]; then
    MISSING_HASH=()
    
    for file in $MODEL_CONFIG_FILES; do
        if [[ "$file" == *"model"* ]] || [[ "$file" == *"config"* ]] || [[ "$file" == *"weight"* ]]; then
            if [ -f "$file" ]; then
                # Check if file contains constitutional reference
                if ! git diff --cached "$file" | grep -qi "constitutional\|constitution\|governance"; then
                    MISSING_HASH+=("$file")
                fi
            fi
        fi
    done
    
    if [ ${#MISSING_HASH[@]} -gt 0 ]; then
        echo -e "   ${YELLOW}⚠️  Model/config files may need constitutional hash:${NC}"
        printf '      - %s\n' "${MISSING_HASH[@]}"
        echo ""
        echo "   Consider adding constitutional metadata:"
        echo "   • constitutional_version: \"1.0\""
        echo "   • constitutional_hash: \"[SHA-256 of GOVERNANCE.md]\""
        echo ""
        echo "   Reference: GOVERNANCE.md Article 6.2"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "   ${GREEN}✅ Constitutional references present${NC}"
    fi
else
    echo "   No model/config files to check"
fi

# Check 3: Verify no silent constitutional overrides
echo ""
echo "3️⃣  Silent Override Detection"
echo "   Checking for unauthorized constitutional bypasses..."

GOVERNANCE_FILES=$(echo "$STAGED_FILES" | grep -E '(GOVERNANCE|\.constitution|constitutional|governance)' || true)

if [ -n "$GOVERNANCE_FILES" ]; then
    echo -e "   ${BLUE}ℹ️  Constitutional files modified:${NC}"
    echo "$GOVERNANCE_FILES" | while read -r file; do
        echo "      - $file"
    done
    echo ""
    echo "   ⚠️  REMINDER: Constitutional changes require:"
    echo "   • 14-day community review period"
    echo "   • Explicit signed commit by steward"
    echo "   • Version increment and rationale"
    echo ""
    echo "   Reference: GOVERNANCE.md Article 8"
    WARNINGS=$((WARNINGS + 1))
fi

# Check 4: Harm precedence validation for ML/AI code
echo ""
echo "4️⃣  Harm Precedence Check"
echo "   Checking AI/ML code for safety mechanisms..."

AI_ML_FILES=$(echo "$STAGED_FILES" | grep -E '(model|neural|ai_|ml_|predict|inference).*\.(py|js|ts|cpp|java)$' || true)

if [ -n "$AI_ML_FILES" ]; then
    MISSING_SAFETY=()
    
    for file in $AI_ML_FILES; do
        if [ -f "$file" ]; then
            CONTENT=$(cat "$file" | tr '[:upper:]' '[:lower:]')
            
            # Check for safety mechanisms
            HAS_UNCERTAINTY=false
            HAS_ESCALATION=false
            HAS_FALLBACK=false
            
            if echo "$CONTENT" | grep -qE "(confidence|uncertainty|threshold)"; then
                HAS_UNCERTAINTY=true
            fi
            if echo "$CONTENT" | grep -qE "(escalate|human.intervention|override)"; then
                HAS_ESCALATION=true
            fi
            if echo "$CONTENT" | grep -qE "(fallback|safe.mode|degrade)"; then
                HAS_FALLBACK=true
            fi
            
            if [ "$HAS_UNCERTAINTY" = false ] || [ "$HAS_ESCALATION" = false ] || [ "$HAS_FALLBACK" = false ]; then
                MISSING_SAFETY+=("$file")
            fi
        fi
    done
    
    if [ ${#MISSING_SAFETY[@]} -gt 0 ]; then
        echo -e "   ${YELLOW}⚠️  AI/ML files may lack harm precedence mechanisms:${NC}"
        printf '      - %s\n' "${MISSING_SAFETY[@]}"
        echo ""
        echo "   Ensure implementations include:"
        echo "   • Uncertainty/confidence thresholds"
        echo "   • Human escalation pathways"
        echo "   • Graceful degradation to safe mode"
        echo ""
        echo "   Reference: GOVERNANCE.md Article 4"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "   ${GREEN}✅ Safety mechanisms detected${NC}"
    fi
else
    echo "   No AI/ML files to check"
fi

# Check 5: Decision transparency markers
echo ""
echo "5️⃣  Decision Transparency Check"
echo "   Checking for documented decision rationale..."

DECISION_FILES=$(echo "$STAGED_FILES" | grep -E '\.(py|js|ts|java|cpp)$' || true)

if [ -n "$DECISION_FILES" ]; then
    # Look for decision-making code without documentation
    UNDOCUMENTED=()
    
    for file in $DECISION_FILES; do
        if [ -f "$file" ]; then
            CONTENT=$(cat "$file")
            
            # Check for decision keywords
            if echo "$CONTENT" | grep -qiE "(def decide|function decide|class.*decision|if.*critical|auto.*approve)"; then
                # Check if there's documentation nearby
                if ! echo "$CONTENT" | grep -qE "(\"\"\".*rationale|'''.*rationale|//.*rationale|/\*.*rationale)"; then
                    UNDOCUMENTED+=("$file")
                fi
            fi
        fi
    done
    
    if [ ${#UNDOCUMENTED[@]} -gt 0 ]; then
        echo -e "   ${YELLOW}⚠️  Decision-making code may lack rationale documentation:${NC}"
        printf '      - %s\n' "${UNDOCUMENTED[@]}"
        echo ""
        echo "   Add documentation explaining:"
        echo "   • Decision logic and criteria"
        echo "   • Human authority responsible"
        echo "   • Rationale for automation"
        echo ""
        echo "   Reference: GOVERNANCE.md Article 6"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "   ${GREEN}✅ Decision documentation appears adequate${NC}"
    fi
else
    echo "   No code files to check"
fi

# Summary
echo ""
echo "=============================================="
echo "📊 Constitutional Compliance Summary"
echo "=============================================="

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}✅ All checks passed!${NC}"
    echo ""
    echo "Your commit complies with the Digital Constitution."
    exit 0
elif [ $ERRORS -eq 0 ]; then
    echo -e "${YELLOW}⚠️  ${WARNINGS} warning(s) detected${NC}"
    echo ""
    echo "Constitutional compliance warnings do not block commits,"
    echo "but please review the guidance above."
    echo ""
    echo "These are reminders to ensure constitutional requirements"
    echo "are addressed in your PR or documentation."
    echo ""
    echo "✅ Proceeding with commit..."
    exit 0
else
    echo -e "${RED}❌ ${ERRORS} error(s) detected${NC}"
    echo -e "${YELLOW}⚠️  ${WARNINGS} warning(s) detected${NC}"
    echo ""
    echo "Your commit violates constitutional requirements."
    echo "Please address the errors above before committing."
    echo ""
    echo "To bypass (not recommended): git commit --no-verify"
    exit 1
fi
