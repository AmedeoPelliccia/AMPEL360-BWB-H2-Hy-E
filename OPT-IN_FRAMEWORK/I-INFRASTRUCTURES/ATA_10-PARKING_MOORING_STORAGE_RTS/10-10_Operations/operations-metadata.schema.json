{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ampel360.com/schemas/operations-metadata.schema.json",
  "title": "Operations Metadata Schema",
  "description": "JSON Schema for ATA 10-10 Operations metadata, supporting parking, mooring, storage, H2, cryo, BWB, and turnaround operations",
  "type": "object",
  "required": [
    "document_id",
    "document_number",
    "title",
    "revision",
    "operation_type",
    "safety_critical"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique document identifier",
      "pattern": "^10-10-[0-9]{2}[A-Z]$",
      "examples": ["10-10-01A", "10-10-35B"]
    },
    "document_number": {
      "type": "string",
      "description": "Full document number including description",
      "pattern": "^10-10-[0-9]{2}[A-Z]_[A-Z0-9_]+$",
      "examples": ["10-10-01A_Parking_Operations_Overview"]
    },
    "title": {
      "type": "string",
      "description": "Human-readable document title",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "string",
      "description": "Document revision letter",
      "pattern": "^[A-Z]$",
      "examples": ["A", "B", "C"]
    },
    "operation_type": {
      "type": "string",
      "description": "Type of operation documented",
      "enum": [
        "parking",
        "mooring",
        "storage",
        "h2-ground",
        "cryo",
        "bwb-ground",
        "turnaround",
        "checklist",
        "template"
      ]
    },
    "h2_related": {
      "type": "boolean",
      "description": "Indicates if procedure involves hydrogen systems",
      "default": false
    },
    "cryo_related": {
      "type": "boolean",
      "description": "Indicates if procedure involves cryogenic systems",
      "default": false
    },
    "bwb_specific": {
      "type": "boolean",
      "description": "Indicates if procedure is specific to BWB configuration",
      "default": false
    },
    "safety_critical": {
      "type": "boolean",
      "description": "Indicates if procedure is safety-critical",
      "default": false
    },
    "personnel_required": {
      "type": "array",
      "description": "List of personnel roles required for the operation",
      "items": {
        "type": "object",
        "required": ["role", "quantity"],
        "properties": {
          "role": {
            "type": "string",
            "description": "Personnel role/qualification",
            "examples": ["Licensed Technician", "H2 Safety Officer", "Lead Mechanic", "Inspector"]
          },
          "quantity": {
            "type": "integer",
            "description": "Number of personnel required",
            "minimum": 1
          },
          "certification": {
            "type": "string",
            "description": "Required certification or qualification",
            "examples": ["A&P License", "H2 Safety Training Level 3", "BWB Type Rating"]
          }
        }
      },
      "default": []
    },
    "equipment_required": {
      "type": "array",
      "description": "List of equipment/GSE required for the operation",
      "items": {
        "type": "object",
        "required": ["equipment", "quantity"],
        "properties": {
          "equipment": {
            "type": "string",
            "description": "Equipment name or GSE identifier",
            "examples": ["Tow Bar", "H2 Detector", "Wheel Chocks", "Mooring Kit"]
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity required",
            "minimum": 1
          },
          "specification": {
            "type": "string",
            "description": "Equipment specification or part number"
          }
        }
      },
      "default": []
    },
    "duration_estimate": {
      "type": "object",
      "description": "Estimated time to complete the operation",
      "properties": {
        "minimum_minutes": {
          "type": "integer",
          "description": "Minimum duration in minutes",
          "minimum": 0
        },
        "maximum_minutes": {
          "type": "integer",
          "description": "Maximum duration in minutes",
          "minimum": 0
        },
        "typical_minutes": {
          "type": "integer",
          "description": "Typical duration in minutes",
          "minimum": 0
        }
      }
    },
    "weather_limitations": {
      "type": "object",
      "description": "Weather limitations for the operation",
      "properties": {
        "max_wind_speed_kts": {
          "type": "number",
          "description": "Maximum wind speed in knots",
          "minimum": 0
        },
        "max_crosswind_kts": {
          "type": "number",
          "description": "Maximum crosswind in knots",
          "minimum": 0
        },
        "min_temperature_c": {
          "type": "number",
          "description": "Minimum temperature in Celsius"
        },
        "max_temperature_c": {
          "type": "number",
          "description": "Maximum temperature in Celsius"
        },
        "precipitation": {
          "type": "string",
          "description": "Precipitation limitations",
          "enum": ["None", "Light", "Moderate", "Any"]
        },
        "visibility_minimum_m": {
          "type": "number",
          "description": "Minimum visibility in meters",
          "minimum": 0
        }
      }
    },
    "revision_history": {
      "type": "array",
      "description": "Document revision history",
      "items": {
        "type": "object",
        "required": ["revision", "date", "author", "description"],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision letter",
            "pattern": "^[A-Z]$"
          },
          "date": {
            "type": "string",
            "description": "Revision date",
            "format": "date"
          },
          "author": {
            "type": "string",
            "description": "Author of the revision"
          },
          "description": {
            "type": "string",
            "description": "Description of changes"
          }
        }
      },
      "default": []
    },
    "applicable_standards": {
      "type": "array",
      "description": "Applicable industry standards and regulations",
      "items": {
        "type": "string"
      },
      "examples": [
        "ATA iSpec 2200",
        "ATA 100 Chapter 10",
        "IATA Ground Operations Manual",
        "SAE AS6968",
        "NFPA 2",
        "ISO 13984"
      ],
      "default": []
    },
    "cross_references": {
      "type": "array",
      "description": "References to related documents",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "description": "Referenced document ID"
          },
          "title": {
            "type": "string",
            "description": "Referenced document title"
          },
          "relationship": {
            "type": "string",
            "description": "Relationship type",
            "enum": ["prerequisite", "related", "supersedes", "superseded_by", "reference"]
          }
        }
      },
      "default": []
    }
  }
}
