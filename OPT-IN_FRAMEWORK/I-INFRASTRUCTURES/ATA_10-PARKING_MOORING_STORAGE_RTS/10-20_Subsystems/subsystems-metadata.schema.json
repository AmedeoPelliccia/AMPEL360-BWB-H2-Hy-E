{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ampel360.com/schemas/subsystems-metadata.schema.json",
  "title": "AMPEL360 Subsystems Metadata Schema",
  "description": "Schema for subsystem metadata in ATA 10 Subsystems directory",
  "type": "object",
  "required": [
    "document_id",
    "document_number",
    "title",
    "revision",
    "subsystem_type",
    "subsystem_id",
    "function_description"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique document identifier (UUID)"
    },
    "document_number": {
      "type": "string",
      "pattern": "^10-20-[0-9]{2}[A-Z]$",
      "description": "Document number following ATA 10-20 convention (e.g., 10-20-01A, 10-20-30A)",
      "examples": [
        "10-20-01A",
        "10-20-30A",
        "10-20-71A"
      ]
    },
    "title": {
      "type": "string",
      "description": "Full document title",
      "minLength": 5,
      "maxLength": 200
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$",
      "description": "Document revision letter (A, B, C, etc.)"
    },
    "subsystem_type": {
      "type": "string",
      "enum": [
        "tiedown",
        "mooring",
        "ground-lock",
        "h2-safety",
        "cryo",
        "preservation",
        "monitoring",
        "bwb"
      ],
      "description": "Type of subsystem"
    },
    "subsystem_id": {
      "type": "string",
      "description": "Unique subsystem identifier",
      "pattern": "^[A-Z0-9-]+$"
    },
    "function_description": {
      "type": "string",
      "description": "Brief functional description of the subsystem",
      "minLength": 20,
      "maxLength": 500
    },
    "interfaces": {
      "type": "array",
      "description": "Array of system interfaces",
      "items": {
        "type": "object",
        "required": ["interface_id", "interface_type", "connected_system"],
        "properties": {
          "interface_id": {
            "type": "string",
            "description": "Interface identifier"
          },
          "interface_type": {
            "type": "string",
            "enum": ["mechanical", "electrical", "pneumatic", "hydraulic", "cryogenic", "data", "thermal"],
            "description": "Type of interface"
          },
          "connected_system": {
            "type": "string",
            "description": "System or component connected via this interface"
          },
          "ata_chapter": {
            "type": "string",
            "pattern": "^ATA [0-9]{2,3}$",
            "description": "ATA chapter of connected system"
          },
          "description": {
            "type": "string",
            "description": "Interface description"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Array of subsystem components",
      "items": {
        "type": "object",
        "required": ["component_id", "component_name", "component_type"],
        "properties": {
          "component_id": {
            "type": "string",
            "description": "Component identifier"
          },
          "component_name": {
            "type": "string",
            "description": "Component name"
          },
          "component_type": {
            "type": "string",
            "description": "Type of component"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of instances"
          },
          "part_number": {
            "type": "string",
            "description": "Part number reference"
          },
          "supplier": {
            "type": "string",
            "description": "Component supplier"
          }
        }
      }
    },
    "h2_related": {
      "type": "boolean",
      "description": "Whether the subsystem is related to hydrogen systems"
    },
    "cryo_related": {
      "type": "boolean",
      "description": "Whether the subsystem handles cryogenic operations"
    },
    "bwb_specific": {
      "type": "boolean",
      "description": "Whether the subsystem is specific to BWB configuration"
    },
    "safety_critical": {
      "type": "boolean",
      "description": "Whether the subsystem is safety-critical"
    },
    "dal_level": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"],
      "description": "Design Assurance Level (DAL) per DO-178C/DO-254"
    },
    "weight": {
      "type": "object",
      "description": "Subsystem weight",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": ["kg", "lbs"],
          "default": "kg"
        }
      }
    },
    "power_requirements": {
      "type": "object",
      "description": "Power requirements for the subsystem",
      "properties": {
        "voltage": {
          "type": "number",
          "description": "Operating voltage (V)"
        },
        "current_max": {
          "type": "number",
          "description": "Maximum current draw (A)"
        },
        "power_max": {
          "type": "number",
          "description": "Maximum power consumption (W)"
        },
        "power_type": {
          "type": "string",
          "enum": ["AC", "DC", "28VDC", "115VAC", "230VAC", "N/A"],
          "description": "Type of power"
        }
      }
    },
    "mtbf": {
      "type": "object",
      "description": "Mean Time Between Failures",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": ["hours", "cycles", "years"]
        }
      }
    },
    "mttr": {
      "type": "object",
      "description": "Mean Time To Repair",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": ["hours", "minutes"]
        }
      }
    },
    "operating_temperature": {
      "type": "object",
      "description": "Operating temperature range",
      "properties": {
        "min": {
          "type": "number",
          "description": "Minimum operating temperature (°C)"
        },
        "max": {
          "type": "number",
          "description": "Maximum operating temperature (°C)"
        }
      }
    },
    "certification_basis": {
      "type": "array",
      "description": "Applicable certification standards",
      "items": {
        "type": "string",
        "examples": [
          "CS-25.1309",
          "SAE ARP4754A",
          "SAE ARP4761",
          "SAE AS6968",
          "ISO 13984",
          "DO-178C",
          "DO-254",
          "MIL-STD-882"
        ]
      }
    },
    "verification_methods": {
      "type": "array",
      "description": "Verification methods used",
      "items": {
        "type": "string",
        "enum": ["test", "analysis", "inspection", "demonstration", "simulation"]
      }
    },
    "related_documents": {
      "type": "array",
      "description": "Related documentation references",
      "items": {
        "type": "object",
        "required": ["doc_number", "doc_type"],
        "properties": {
          "doc_number": {
            "type": "string",
            "description": "Document number"
          },
          "doc_type": {
            "type": "string",
            "enum": ["requirement", "design", "test", "installation", "maintenance", "drawing"],
            "description": "Type of document"
          },
          "title": {
            "type": "string",
            "description": "Document title"
          }
        }
      }
    },
    "revision_history": {
      "type": "array",
      "description": "Document revision history",
      "items": {
        "type": "object",
        "required": ["revision", "date", "author", "description"],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision identifier (A, B, C, etc.)"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Revision date"
          },
          "author": {
            "type": "string",
            "description": "Author of the revision"
          },
          "description": {
            "type": "string",
            "description": "Description of changes"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "active", "obsolete"],
      "description": "Document status"
    },
    "owner": {
      "type": "string",
      "description": "Document owner or responsible party"
    },
    "approver": {
      "type": "string",
      "description": "Document approver"
    }
  }
}
