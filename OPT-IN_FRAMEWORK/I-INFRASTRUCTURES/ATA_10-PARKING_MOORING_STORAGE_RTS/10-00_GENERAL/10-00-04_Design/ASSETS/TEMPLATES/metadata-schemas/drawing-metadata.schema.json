{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drawing Metadata Schema",
  "type": "object",
  "required": ["drawing_number", "title", "revision"],
  "properties": {
    "drawing_number": {"type": "string"},
    "title": {"type": "string"},
    "revision": {"type": "string"},
    "sheet": {"type": "integer"},
    "scale": {"type": "string"},
    "size": {"type": "string", "enum": ["A", "A0", "A1", "A2", "A3", "A4"]},
    "cage_code": {"type": "string"},
    "related_parts": {"type": "array", "items": {"type": "string"}},
    "related_assemblies": {"type": "array", "items": {"type": "string"}}
  }
}
