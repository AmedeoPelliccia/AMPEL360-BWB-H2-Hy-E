{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ampel360.amedeopelliccia.it/schemas/ata10-model-metadata.schema.json",
  "title": "ATA 10 Model Metadata Schema",
  "description": "JSON Schema for CAD model metadata in ATA 10 Parking, Mooring, Storage & RTS",
  "type": "object",
  "required": [
    "model_id",
    "model_number",
    "title",
    "description",
    "model_type",
    "version",
    "created_at",
    "created_by",
    "status"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the model (UUID format)"
    },
    "model_number": {
      "type": "string",
      "pattern": "^10-MDL-(ASM|TD|MR|PK|H2)-[0-9]{3}$",
      "description": "Model number following ATA 10 naming convention (e.g., 10-MDL-ASM-001)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable title of the model"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Detailed description of the model and its purpose"
    },
    "model_type": {
      "type": "string",
      "enum": [
        "assembly",
        "component",
        "simulation"
      ],
      "description": "Type of model"
    },
    "component_category": {
      "type": "string",
      "enum": [
        "tiedown",
        "mooring",
        "parking",
        "h2-system",
        "general"
      ],
      "description": "Component category (for component type models)"
    },
    "simulation_type": {
      "type": "string",
      "enum": [
        "fea",
        "cfd",
        "multibody",
        "thermal",
        "other"
      ],
      "description": "Simulation analysis type (for simulation type models)"
    },
    "cad_system": {
      "type": "string",
      "enum": [
        "CATIA",
        "SolidWorks",
        "NX",
        "Inventor",
        "Other"
      ],
      "description": "Primary CAD system used to create the model"
    },
    "cad_version": {
      "type": "string",
      "description": "Version of the CAD system used (e.g., 'V5R21', '2023 SP3')"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Model version number (semantic versioning: major.minor.patch)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of model creation (ISO 8601 format)"
    },
    "created_by": {
      "type": "string",
      "description": "Name or identifier of the person who created the model"
    },
    "modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of last modification (ISO 8601 format)"
    },
    "modified_by": {
      "type": "string",
      "description": "Name or identifier of the person who last modified the model"
    },
    "file_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "filename"],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "CATPart",
              "CATProduct",
              "sldprt",
              "sldasm",
              "prt",
              "step",
              "iges",
              "jt",
              "stl",
              "obj",
              "gltf",
              "glb"
            ],
            "description": "File format"
          },
          "filename": {
            "type": "string",
            "description": "Name of the file"
          },
          "file_size": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes"
          },
          "checksum": {
            "type": "string",
            "description": "SHA-256 checksum of the file"
          },
          "path": {
            "type": "string",
            "description": "Relative path to the file within MODELS directory"
          }
        }
      },
      "description": "Array of available file formats for this model"
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "minimum": 0,
          "description": "Length in millimeters"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "Width in millimeters"
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Height in millimeters"
        },
        "unit": {
          "type": "string",
          "enum": ["mm", "cm", "m", "in", "ft"],
          "default": "mm",
          "description": "Unit of measurement"
        }
      },
      "description": "Bounding box dimensions of the model"
    },
    "weight": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Weight value"
        },
        "unit": {
          "type": "string",
          "enum": ["g", "kg", "lb", "oz"],
          "default": "kg",
          "description": "Unit of weight"
        },
        "calculated": {
          "type": "boolean",
          "description": "Whether weight is calculated from CAD or measured"
        }
      },
      "description": "Weight information (if applicable)"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Material name or designation"
          },
          "specification": {
            "type": "string",
            "description": "Material specification (e.g., 'AMS 5510', 'ISO 683-17')"
          },
          "part_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Part numbers using this material"
          },
          "properties": {
            "type": "object",
            "properties": {
              "density": {
                "type": "number",
                "description": "Density in kg/m³"
              },
              "yield_strength": {
                "type": "number",
                "description": "Yield strength in MPa"
              },
              "ultimate_strength": {
                "type": "number",
                "description": "Ultimate tensile strength in MPa"
              },
              "elastic_modulus": {
                "type": "number",
                "description": "Elastic modulus in GPa"
              }
            },
            "description": "Material properties"
          }
        }
      },
      "description": "Array of materials used in the model"
    },
    "related_drawings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^10-[0-9]{2}-[0-9]{2}-A[0-9]{3}.*$"
      },
      "description": "Array of related drawing numbers (AMPEL360 format)"
    },
    "related_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-10-.*$"
      },
      "description": "Array of related requirement IDs"
    },
    "related_models": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^10-(MDL|SIM)-.*-[0-9]{3}$"
      },
      "description": "Array of related model numbers"
    },
    "bwb_specific": {
      "type": "boolean",
      "description": "Whether this model is specific to BWB configuration"
    },
    "h2_related": {
      "type": "boolean",
      "description": "Whether this model is related to hydrogen systems"
    },
    "safety_critical": {
      "type": "boolean",
      "description": "Whether this model represents a safety-critical component"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "approved",
        "released",
        "obsolete"
      ],
      "description": "Current status of the model"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "name", "date"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "designer",
              "lead-engineer",
              "stress-engineer",
              "safety-engineer",
              "configuration-manager",
              "chief-engineer"
            ],
            "description": "Role of the approver"
          },
          "name": {
            "type": "string",
            "description": "Name of the approver"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of approval"
          },
          "signature": {
            "type": "string",
            "description": "Digital signature or approval reference"
          },
          "comments": {
            "type": "string",
            "description": "Approval comments or conditions"
          }
        }
      },
      "description": "Array of approvals for this model"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision", "date", "author", "description"],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision identifier (e.g., 'A', 'B', '1.0', '1.1')"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of revision"
          },
          "author": {
            "type": "string",
            "description": "Author of the revision"
          },
          "description": {
            "type": "string",
            "description": "Description of changes in this revision"
          }
        }
      },
      "description": "Revision history of the model"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags for categorizing the model"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000,
      "description": "Additional notes or comments about the model"
    }
  }
}
