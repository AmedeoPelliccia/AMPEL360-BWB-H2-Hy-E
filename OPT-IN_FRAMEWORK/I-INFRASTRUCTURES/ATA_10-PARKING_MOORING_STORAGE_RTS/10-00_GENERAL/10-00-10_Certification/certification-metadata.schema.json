{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampel360.aero/schemas/ata10/certification-metadata.schema.json",
  "title": "ATA 10 Certification Document Metadata",
  "description": "Schema for certification documentation metadata in ATA 10 - Parking, Mooring, Storage & RTS",
  "type": "object",
  "required": [
    "document_id",
    "document_number",
    "title",
    "revision",
    "document_type",
    "status"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^10-00-10-[0-9]{2}[A-Z]$",
      "description": "Document identifier following pattern: 10-00-10-NNA (e.g., 10-00-10-01A)"
    },
    "document_number": {
      "type": "string",
      "description": "Full document number including title"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$",
      "description": "Document revision letter (A, B, C, etc.)"
    },
    "version": {
      "type": "string",
      "description": "Version number (e.g., 1.0, 2.1)"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "cert-plan",
        "compliance-matrix",
        "moc",
        "special-condition",
        "certification-basis",
        "conformity",
        "doa-poa",
        "authority-correspondence",
        "template"
      ],
      "description": "Type of certification document"
    },
    "regulation_reference": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Referenced regulations (e.g., CS-25.1309, FAR 25.1581, NFPA 2)"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "not-compliant",
        "not-applicable",
        "in-progress",
        "pending-review",
        "approved"
      ],
      "description": "Current compliance status"
    },
    "h2_related": {
      "type": "boolean",
      "description": "Whether document relates to hydrogen systems"
    },
    "cryo_related": {
      "type": "boolean",
      "description": "Whether document relates to cryogenic systems"
    },
    "bwb_specific": {
      "type": "boolean",
      "description": "Whether document is specific to BWB configuration"
    },
    "lh2_specific": {
      "type": "boolean",
      "description": "Whether document is specific to liquid hydrogen systems"
    },
    "authority": {
      "type": "string",
      "enum": [
        "EASA",
        "FAA",
        "both",
        "other"
      ],
      "description": "Certification authority"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "internal-review",
        "submitted",
        "under-review",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "description": "Authority approval status"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Date of authority approval (ISO 8601)"
    },
    "submission_date": {
      "type": "string",
      "format": "date",
      "description": "Date submitted to authority (ISO 8601)"
    },
    "owner": {
      "type": "string",
      "description": "Document owner or responsible party"
    },
    "created_date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date (ISO 8601)"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (ISO 8601)"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "date",
          "description"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision letter"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Revision date"
          },
          "author": {
            "type": "string",
            "description": "Author of revision"
          },
          "description": {
            "type": "string",
            "description": "Description of changes"
          },
          "approved_by": {
            "type": "string",
            "description": "Person who approved the revision"
          }
        }
      },
      "description": "Document revision history"
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related document IDs or references"
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Evidence identifier"
          },
          "description": {
            "type": "string",
            "description": "Evidence description"
          },
          "location": {
            "type": "string",
            "description": "Location/path to evidence"
          }
        }
      },
      "description": "References to supporting evidence"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords for searchability"
    },
    "ata_chapter": {
      "type": "string",
      "const": "ATA 10",
      "description": "ATA chapter designation"
    },
    "ata_section": {
      "type": "string",
      "const": "10-00-10",
      "description": "ATA section designation"
    }
  }
}
