{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampel360.aero/schemas/ata10/subsystems-metadata.schema.json",
  "title": "ATA 10 Subsystems Metadata",
  "description": "Metadata schema for ATA 10 Parking, Mooring, Storage & RTS subsystems and components",
  "type": "object",
  "required": ["document_id", "document_number", "title", "revision", "subsystem_type", "subsystem_id"],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^10-00-13-[0-9]{2}[A-Z]$",
      "description": "Document identifier following ATA 10-00-13-NNA pattern"
    },
    "document_number": {
      "type": "string",
      "description": "Full document number with descriptive title"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Subsystem or component title"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$",
      "description": "Document revision letter (A, B, C, etc.)"
    },
    "subsystem_type": {
      "type": "string",
      "enum": [
        "architecture",
        "parking",
        "mooring",
        "storage",
        "h2-safety",
        "cryo",
        "bwb",
        "component-breakdown"
      ],
      "description": "Type of subsystem or component category"
    },
    "subsystem_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$",
      "description": "Unique subsystem identifier"
    },
    "parent_system": {
      "type": "string",
      "description": "Parent system or higher-level subsystem ID"
    },
    "child_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "component_name"],
        "properties": {
          "component_id": {
            "type": "string",
            "description": "Unique component identifier"
          },
          "component_name": {
            "type": "string",
            "description": "Component name or title"
          },
          "part_number": {
            "type": "string",
            "description": "Part number if applicable"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantity required"
          },
          "criticality": {
            "type": "string",
            "enum": ["critical", "essential", "important", "standard"],
            "description": "Component criticality level"
          }
        }
      },
      "description": "Array of child components within this subsystem"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["interface_id", "interface_type", "connected_system"],
        "properties": {
          "interface_id": {
            "type": "string",
            "description": "Unique interface identifier"
          },
          "interface_type": {
            "type": "string",
            "enum": [
              "mechanical",
              "electrical",
              "hydraulic",
              "pneumatic",
              "h2-gas",
              "lh2-liquid",
              "data",
              "thermal",
              "structural"
            ],
            "description": "Type of interface"
          },
          "connected_system": {
            "type": "string",
            "description": "System or subsystem connected via this interface"
          },
          "interface_spec": {
            "type": "string",
            "description": "Reference to interface specification document"
          }
        }
      },
      "description": "Array of interfaces to other systems or subsystems"
    },
    "h2_related": {
      "type": "boolean",
      "default": false,
      "description": "True if subsystem is hydrogen-related"
    },
    "cryo_related": {
      "type": "boolean",
      "default": false,
      "description": "True if subsystem involves cryogenic temperatures"
    },
    "bwb_specific": {
      "type": "boolean",
      "default": false,
      "description": "True if subsystem is BWB configuration-specific"
    },
    "safety_critical": {
      "type": "boolean",
      "default": false,
      "description": "True if subsystem is safety-critical"
    },
    "dal_level": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "N/A"],
      "description": "Design Assurance Level per DO-178C/DO-254"
    },
    "applicable_standards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of applicable standards and regulations"
    },
    "operational_domain": {
      "type": "object",
      "properties": {
        "temperature_range": {
          "type": "object",
          "properties": {
            "min_celsius": { "type": "number" },
            "max_celsius": { "type": "number" }
          }
        },
        "pressure_range": {
          "type": "object",
          "properties": {
            "min_bar": { "type": "number" },
            "max_bar": { "type": "number" }
          }
        },
        "wind_speed_limit_kts": {
          "type": "number",
          "minimum": 0
        },
        "humidity_range": {
          "type": "object",
          "properties": {
            "min_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "max_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      },
      "description": "Operational domain parameters"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision", "date", "author", "description"],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Revision history entries"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "FOR_REVIEW", "APPROVED", "OBSOLETE", "SUPERSEDED"],
      "default": "DRAFT",
      "description": "Document status"
    },
    "owner": {
      "type": "string",
      "description": "Document owner or responsible party"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date"
    }
  }
}
