{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampel360.aero/schemas/ata10/ops-std-metadata.schema.json",
  "title": "Operations & Standards Metadata Schema",
  "description": "Metadata schema for ATA 10-00-14 operations, standards, and sustainment documents",
  "type": "object",
  "required": [
    "document_id",
    "document_number",
    "title",
    "revision",
    "document_type",
    "status"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^10-00-14-[0-9]{2}[A-Z]$",
      "description": "Document ID following pattern 10-00-14-NNA where NN is 01-99 and A is revision letter",
      "examples": ["10-00-14-01A", "10-00-14-23B", "10-00-14-61A"]
    },
    "document_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "description": "Sequential document number (01-99)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Document title"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$",
      "description": "Revision letter (A, B, C, ...)",
      "default": "A"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "procedure",
        "emergency",
        "standard",
        "sustainment",
        "safety",
        "environmental",
        "qualification",
        "template"
      ],
      "description": "Type of operational document"
    },
    "category": {
      "type": "string",
      "enum": [
        "operational-procedures",
        "emergency-procedures",
        "applicable-standards",
        "sustainment",
        "safety-operations",
        "environmental",
        "personnel-qualifications",
        "ops-templates"
      ],
      "description": "Document category aligned with directory structure"
    },
    "h2_related": {
      "type": "boolean",
      "description": "Indicates if document is specific to hydrogen operations",
      "default": false
    },
    "cryo_related": {
      "type": "boolean",
      "description": "Indicates if document is specific to cryogenic operations",
      "default": false
    },
    "bwb_specific": {
      "type": "boolean",
      "description": "Indicates if document is specific to BWB configuration",
      "default": false
    },
    "safety_critical": {
      "type": "boolean",
      "description": "Indicates if procedure is safety-critical",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "REVIEW", "APPROVED", "ACTIVE", "SUPERSEDED", "ARCHIVED"],
      "description": "Document lifecycle status"
    },
    "applicable_personnel": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ground_crew",
          "h2_handler",
          "cryo_handler",
          "maintenance_technician",
          "safety_officer",
          "arff_personnel",
          "operations_manager",
          "quality_inspector",
          "all_personnel"
        ]
      },
      "description": "Personnel roles to which this document applies",
      "minItems": 1
    },
    "training_required": {
      "type": "boolean",
      "description": "Indicates if training is required to perform this procedure",
      "default": false
    },
    "certification_required": {
      "type": "boolean",
      "description": "Indicates if certification is required to perform this procedure",
      "default": false
    },
    "certification_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "h2_handler",
          "cryo_handler",
          "ground_ops",
          "emergency_response",
          "none"
        ]
      },
      "description": "Required certification types"
    },
    "review_frequency": {
      "type": "string",
      "enum": ["monthly", "quarterly", "semi-annual", "annual", "biennial", "as-needed"],
      "description": "How often the document should be reviewed"
    },
    "applicable_standards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of applicable standards (e.g., NFPA 2, ISO 13984, SAE AS6968)",
      "examples": [
        ["NFPA 2", "ISO 13984"],
        ["CGA P-12", "ISO 21013"],
        ["SAE AS6968", "ATA iSpec 2200"]
      ]
    },
    "related_ata_chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ATA [0-9]{2}$"
      },
      "description": "Related ATA chapters",
      "examples": [["ATA 05", "ATA 12", "ATA 28"]]
    },
    "emergency_contact_required": {
      "type": "boolean",
      "description": "Indicates if emergency contacts must be available when using this document",
      "default": false
    },
    "ppe_required": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "safety_glasses",
          "face_shield",
          "cryo_gloves",
          "thermal_gloves",
          "insulated_clothing",
          "fire_resistant_clothing",
          "hard_hat",
          "safety_boots",
          "respirator",
          "scba",
          "h2_detector",
          "none"
        ]
      },
      "description": "Required personal protective equipment"
    },
    "environmental_conditions": {
      "type": "object",
      "properties": {
        "max_wind_speed_kt": {
          "type": "number",
          "description": "Maximum wind speed in knots for procedure execution"
        },
        "max_temperature_c": {
          "type": "number",
          "description": "Maximum ambient temperature in Celsius"
        },
        "min_temperature_c": {
          "type": "number",
          "description": "Minimum ambient temperature in Celsius"
        },
        "no_precipitation": {
          "type": "boolean",
          "description": "Indicates if procedure requires no precipitation"
        }
      },
      "description": "Environmental limitations for procedure execution"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision", "date", "description"],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          }
        }
      },
      "description": "Document revision history"
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "relationship"],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "prerequisite",
              "related",
              "supersedes",
              "superseded_by",
              "implements",
              "references"
            ]
          }
        }
      },
      "description": "Cross-references to other documents"
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hazard_type", "severity"],
        "properties": {
          "hazard_type": {
            "type": "string",
            "enum": [
              "h2_leak",
              "h2_fire",
              "cryo_burn",
              "asphyxiation",
              "fire",
              "explosion",
              "electrical_shock",
              "slip_trip_fall",
              "crushing",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["catastrophic", "critical", "major", "minor", "negligible"]
          },
          "mitigation": {
            "type": "string",
            "description": "Brief description of mitigation measures"
          }
        }
      },
      "description": "Identified hazards for this procedure"
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_by": {
          "type": "string",
          "description": "Name of approving authority"
        },
        "approval_date": {
          "type": "string",
          "format": "date"
        },
        "next_review_date": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Document approval information"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_date": {
          "type": "string",
          "format": "date-time"
        },
        "last_modified_date": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "description": "Document owner or responsible party"
        },
        "ai_assisted": {
          "type": "boolean",
          "description": "Indicates if document was created with AI assistance",
          "default": false
        },
        "ai_assistant": {
          "type": "string",
          "description": "Name of AI assistant used"
        },
        "human_reviewer": {
          "type": "string",
          "description": "Name of human reviewer/approver"
        }
      }
    }
  }
}
