{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ampel360.com/schemas/safety/safety-checklist.schema.json",
  "title": "Safety Checklist",
  "description": "Schema for operational safety checklists in ATA 10-00-02 Safety framework",
  "type": "object",
  "required": ["checklist_id", "checklist_name", "operation_type", "items"],
  "properties": {
    "checklist_id": {
      "type": "string",
      "description": "Unique checklist identifier"
    },
    "checklist_name": {
      "type": "string",
      "description": "Name of the checklist"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "PRE_PARKING",
        "MOORING",
        "STORAGE_ENTRY",
        "RTS",
        "H2_OPERATIONS",
        "DAILY_INSPECTION",
        "HV_WORK",
        "CRYOGENIC_OPERATIONS"
      ]
    },
    "version": {
      "type": "string",
      "description": "Checklist version"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "description", "check_type"],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "check_type": {
            "type": "string",
            "enum": ["VERIFICATION", "ACTION", "CONFIRMATION", "MEASUREMENT"]
          },
          "acceptance_criteria": {
            "type": "string"
          },
          "hazards_mitigated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "completion_record": {
      "type": "object",
      "properties": {
        "completed_by": { "type": "string" },
        "completion_date": { "type": "string", "format": "date-time" },
        "all_items_satisfactory": { "type": "boolean" },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": { "type": "string" },
              "issue": { "type": "string" },
              "resolution": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
