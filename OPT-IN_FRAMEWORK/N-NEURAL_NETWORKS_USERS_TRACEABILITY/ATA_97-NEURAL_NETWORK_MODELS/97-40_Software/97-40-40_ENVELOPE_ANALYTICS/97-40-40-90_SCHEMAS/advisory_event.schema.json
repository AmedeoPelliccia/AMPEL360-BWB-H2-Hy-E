{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampel360.aero/schemas/ofec/advisory_event.schema.json",
  "title": "Advisory Event",
  "description": "Advisory state change or exceedance event",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "aircraft_id"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": ["ADVISORY_CHANGE", "EXCEEDANCE_START", "EXCEEDANCE_END", "TREND_CHANGE"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "aircraft_id": {
      "type": "string"
    },
    "flight_phase": {
      "type": "string",
      "enum": ["GROUND", "TAXI", "TAKEOFF", "CLIMB", "CRUISE", "DESCENT", "APPROACH", "LANDING"]
    },
    "advisory": {
      "type": "object",
      "properties": {
        "previous_level": {
          "type": "string",
          "enum": ["NORMAL", "CAUTION", "WARNING", "CRITICAL"]
        },
        "new_level": {
          "type": "string",
          "enum": ["NORMAL", "CAUTION", "WARNING", "CRITICAL"]
        },
        "parameter": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "exceedance": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["MINOR", "MODERATE", "SEVERE"]
        },
        "margin_pct": {
          "type": "number"
        },
        "peak_value": {
          "type": "number"
        },
        "limit_value": {
          "type": "number"
        },
        "duration_sec": {
          "type": "number"
        }
      }
    },
    "position": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_ft": { "type": "number" }
      }
    }
  }
}
