<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://ampel360.aero/schemas/anchors-dmc"
           xmlns:anch="https://ampel360.aero/schemas/anchors-dmc"
           elementFormDefault="qualified"
           version="1.0">

  <xs:annotation>
    <xs:documentation>
      ANCHORS S1000D Data Module Code (DMC) Schema
      Defines the structure for technical publication identifiers
      within ATA Chapter 53 (ANCHORS System)
    </xs:documentation>
  </xs:annotation>

  <!-- ============================================================ -->
  <!-- Root Element -->
  <!-- ============================================================ -->
  
  <xs:element name="anchorsDmc" type="anch:AnchorsDmcType">
    <xs:annotation>
      <xs:documentation>Root element for ANCHORS DMC definition</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- ============================================================ -->
  <!-- Complex Types -->
  <!-- ============================================================ -->

  <xs:complexType name="AnchorsDmcType">
    <xs:sequence>
      <xs:element name="dmcCode" type="anch:DmcCodeType"/>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="issueInfo" type="anch:IssueInfoType"/>
      <xs:element name="infoCode" type="anch:InfoCodeType"/>
      <xs:element name="ataReference" type="anch:AtaReferenceType"/>
      <xs:element name="securityClassification" type="anch:SecurityClassType" minOccurs="0"/>
      <xs:element name="responsiblePartner" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IssueInfoType">
    <xs:sequence>
      <xs:element name="issueNumber" type="xs:positiveInteger"/>
      <xs:element name="inWork" type="xs:positiveInteger"/>
      <xs:element name="issueDate" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AtaReferenceType">
    <xs:sequence>
      <xs:element name="ataChapter" type="xs:string" fixed="53"/>
      <xs:element name="bucket" type="anch:BucketType"/>
      <xs:element name="band" type="anch:BandType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================================================ -->
  <!-- Simple Types -->
  <!-- ============================================================ -->

  <xs:simpleType name="DmcCodeType">
    <xs:annotation>
      <xs:documentation>
        DMC pattern: DMC-AMPEL-A-53-XX-YY-ZZA-NNN-T
        Where:
          AMPEL = Model identifier
          A = Subsystem
          53 = ATA Chapter
          XX = Bucket (00-90)
          YY = Band (00-99)
          ZZ = Sequence
          A = Variant
          NNN = Item number
          T = Type code
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="DMC-AMPEL-[A-Z]-53-[0-9]{2}-[0-9]{2}-[0-9]{2}[A-Z]-[0-9]{3}-[A-Z]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InfoCodeType">
    <xs:annotation>
      <xs:documentation>S1000D Information Code</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation><xs:documentation>Description and operation</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation><xs:documentation>Parts data</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation><xs:documentation>Maintenance procedures</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation><xs:documentation>Fault isolation</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="G">
        <xs:annotation><xs:documentation>Structural data</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="H">
        <xs:annotation><xs:documentation>Wiring data</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="J">
        <xs:annotation><xs:documentation>Time limits and checks</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="K">
        <xs:annotation><xs:documentation>Illustrated parts catalog</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="S">
        <xs:annotation><xs:documentation>Safety data</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="T">
        <xs:annotation><xs:documentation>Training information</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BucketType">
    <xs:annotation>
      <xs:documentation>ATA 53 Bucket identifier (00-90 in steps of 10)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="53-(00|10|20|30|40|50|60|70|80|90)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BandType">
    <xs:annotation>
      <xs:documentation>Band within bucket (00-99)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SecurityClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="01">
        <xs:annotation><xs:documentation>Unclassified</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="02">
        <xs:annotation><xs:documentation>Restricted</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="03">
        <xs:annotation><xs:documentation>Confidential</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="04">
        <xs:annotation><xs:documentation>Secret</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
