{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmip.org/schemas/v0.1/envelope.json",
  "title": "MMIP Memory Envelope",
  "description": "The subset of memory (capsules + summaries + policies) delivered to a model/tool for a single call as defined in MMIP v0.1 Section 4.4",
  "type": "object",
  "required": ["mmip_version", "context_id", "producer", "capsules"],
  "properties": {
    "mmip_version": {
      "type": "string",
      "const": "0.1",
      "description": "MMIP protocol version"
    },
    "context_id": {
      "type": "string",
      "description": "Unique identifier for this context/envelope"
    },
    "thread_id": {
      "type": "string",
      "description": "ID of the thread this envelope belongs to (if applicable)"
    },
    "producer": {
      "type": "object",
      "description": "Information about the agent/model/tool that produced this envelope",
      "required": ["id", "role"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the producer"
        },
        "role": {
          "type": "string",
          "description": "Role of the producer (e.g., 'assistant', 'user', 'system')"
        },
        "type": {
          "type": "string",
          "enum": ["model", "agent", "tool", "user", "system"],
          "description": "Type of producer"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the producer"
        },
        "version": {
          "type": "string",
          "description": "Version of the producer"
        }
      },
      "additionalProperties": true
    },
    "policies": {
      "type": "object",
      "description": "Policies governing this envelope",
      "properties": {
        "visibility": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Which models/tools/agents may access this envelope"
        },
        "retention": {
          "type": "string",
          "enum": ["ephemeral", "session", "long_term", "never_persist"],
          "description": "Retention policy for this envelope"
        },
        "sharing": {
          "type": "object",
          "description": "Sharing policies",
          "properties": {
            "allow_external_providers": {
              "type": "boolean",
              "description": "Whether external providers may access this envelope"
            },
            "require_redaction": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Redaction rules that must be applied before sharing"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "capsules": {
      "type": "array",
      "description": "Array of memory capsules in this envelope",
      "items": {
        "$ref": "https://mmip.org/schemas/v0.1/capsule.json"
      }
    },
    "links": {
      "type": "array",
      "description": "DAG relationships at the envelope level",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of relationship"
          },
          "target_id": {
            "type": "string",
            "description": "ID of the target"
          }
        }
      }
    },
    "external_refs": {
      "type": "array",
      "description": "Optional external references (vector store, file store)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["vector_store", "file_store", "blob_store", "database"],
            "description": "Type of external reference"
          },
          "uri": {
            "type": "string",
            "description": "URI of the external resource"
          },
          "description": {
            "type": "string",
            "description": "Description of the external resource"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "description": "Optional integrity verification",
      "properties": {
        "hash": {
          "type": "string",
          "description": "Cryptographic hash of envelope content (e.g., 'sha256:abc123...')"
        },
        "signature": {
          "type": "string",
          "description": "Cryptographic signature of the envelope"
        },
        "signed_by": {
          "type": "string",
          "description": "ID of the signing entity"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of signing"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "description": "Provenance information for the envelope",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the envelope was created"
        },
        "source_thread_id": {
          "type": "string",
          "description": "ID of the source thread"
        },
        "source_package_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of source packages used to create this envelope"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["summarization", "redaction", "filtering", "compression"],
                "description": "Type of transformation applied"
              },
              "description": {
                "type": "string",
                "description": "Description of the transformation"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "When the transformation was applied"
              }
            }
          },
          "description": "Transformations applied to create this envelope"
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "description": "Vendor-specific extensions (MUST NOT break schema compatibility)",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
