    <!-- ============================================================ -->
    <!-- NOTATION RULES -->
    <!-- ============================================================ -->
    <notationRules>
      <!-- DMC Naming Pattern Enforcement -->
      <notationRule id="GLOBAL-NR-001">
        <objectPath>//dmCode/@modelIdentCode</objectPath>
        <objectValue valuePattern="AMPEL360AT"/>
        <message>Data Module Code must use model identifier: AMPEL360AT</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-002">
        <objectPath>//dmCode/@systemDiffCode</objectPath>
        <objectValue valuePattern="[A-Z]"/>
        <message>System difference code must be a single uppercase letter A-Z</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-003">
        <objectPath>//dmCode/@systemCode</objectPath>
        <objectValue valuePattern="[0-9]{2}"/>
        <message>System code must be a two-digit number</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-004">
        <objectPath>//dmCode/@subSystemCode</objectPath>
        <objectValue valuePattern="[0-9]{1}"/>
        <message>Subsystem code must be a single digit</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-005">
        <objectPath>//dmCode/@subSubSystemCode</objectPath>
        <objectValue valuePattern="[0-9]{1}"/>
        <message>Sub-subsystem code must be a single digit</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-006">
        <objectPath>//dmCode/@assyCode</objectPath>
        <objectValue valuePattern="[0-9]{2}"/>
        <message>Assembly code must be a two-digit number</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-007">
        <objectPath>//dmCode/@disassyCode</objectPath>
        <objectValue valuePattern="[0-9]{2}"/>
        <message>Disassembly code must be a two-digit number</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-008">
        <objectPath>//dmCode/@disassyCodeVariant</objectPath>
        <objectValue valuePattern="[A-Z0-9]"/>
        <message>Disassembly code variant must be A-Z or 0-9</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-009">
        <objectPath>//dmCode/@infoCode</objectPath>
        <objectValue valuePattern="[0-9A-Z]{3}"/>
        <message>Info code must be three characters (digits or uppercase letters)</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-010">
        <objectPath>//dmCode/@infoCodeVariant</objectPath>
        <objectValue valuePattern="[A-Z]"/>
        <message>Info code variant must be a single uppercase letter</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-011">
        <objectPath>//dmCode/@itemLocationCode</objectPath>
        <objectValue valuePattern="[A-Z]"/>
        <message>Item location code must be a single uppercase letter</message>
      </notationRule>
      
      <!-- Language Code Validation (ISO 639-1 / ISO 3166-1) -->
      <notationRule id="GLOBAL-NR-020">
        <objectPath>//language/@languageIsoCode</objectPath>
        <objectValue valuePattern="[a-z]{2,3}"/>
        <message>Language ISO code must be valid ISO 639-1 or ISO 639-2 code (2-3 lowercase letters)</message>
      </notationRule>
      
      <notationRule id="GLOBAL-NR-021">
        <objectPath>//language/@countryIsoCode</objectPath>
        <objectValue valuePattern="[A-Z]{2}"/>
        <message>Country ISO code must be valid ISO 3166-1 alpha-2 code (2 uppercase letters)</message>
      </notationRule>
    </notationRules>
    
