        <proceduralIdent proceduralIdentNumber="P002"/>
        <proceduralTitle>Static Discharge Procedure</proceduralTitle>
        <proceduralContent>
          <proceduralStep>
            <para>Enter ESD-protected work area</para>
          </proceduralStep>
          <proceduralStep>
            <para>Attach ESD wrist strap to grounded workstation</para>
          </proceduralStep>
          <proceduralStep>
            <para>Verify wrist strap continuity using ESD tester</para>
          </proceduralStep>
          <proceduralStep>
            <para>Place equipment on grounded ESD mat</para>
          </proceduralStep>
          <proceduralStep>
            <para>Handle circuit boards by edges only</para>
          </proceduralStep>
          <proceduralStep>
            <para>Use ESD-safe tools for all work</para>
          </proceduralStep>
          <proceduralStep>
            <para>Store removed components in anti-static bags</para>
          </proceduralStep>
        </proceduralContent>
      </proceduralSpec>
    </proceduralRepository>
  </commonRepositoryContent>
