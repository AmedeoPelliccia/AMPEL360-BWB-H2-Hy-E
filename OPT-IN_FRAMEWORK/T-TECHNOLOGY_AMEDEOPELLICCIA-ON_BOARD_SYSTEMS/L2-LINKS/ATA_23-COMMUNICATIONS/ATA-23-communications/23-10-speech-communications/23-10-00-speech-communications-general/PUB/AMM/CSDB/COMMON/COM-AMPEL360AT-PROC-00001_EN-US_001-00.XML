        <proceduralIdent proceduralIdentNumber="P001"/>
        <proceduralTitle>RF Energy Safety Procedure</proceduralTitle>
        <proceduralContent>
          <proceduralStep>
            <para>Ensure all aircraft transmitters are set to OFF or STANDBY</para>
          </proceduralStep>
          <proceduralStep>
            <para>Verify no active transmissions on communication frequencies</para>
          </proceduralStep>
          <proceduralStep>
            <para>If applicable, disconnect antenna feedlines from transmitters</para>
          </proceduralStep>
          <proceduralStep>
            <para>Post RF HAZARD warning signs near antenna locations</para>
          </proceduralStep>
          <proceduralStep>
            <para>Maintain minimum safe distance from antennas during testing</para>
          </proceduralStep>
          <proceduralStep>
            <para>Use RF power meter to verify zero output before antenna work</para>
          </proceduralStep>
        </proceduralContent>
      </proceduralSpec>
    </proceduralRepository>
  </commonRepositoryContent>
