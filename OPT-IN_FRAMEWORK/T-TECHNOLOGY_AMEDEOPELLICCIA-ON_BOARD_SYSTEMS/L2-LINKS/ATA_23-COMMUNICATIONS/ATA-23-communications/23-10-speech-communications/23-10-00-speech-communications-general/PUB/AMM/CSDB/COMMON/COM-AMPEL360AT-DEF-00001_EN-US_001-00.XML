    <definitionRepository>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D001"/>
        <definitionTerm>VHF Band</definitionTerm>
        <definitionContent>
          <para>Very High Frequency band, 30-300 MHz. Used for primary aircraft voice communications (118-137 MHz)</para>
        </definitionContent>
      </definitionSpec>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D002"/>
        <definitionTerm>HF Band</definitionTerm>
        <definitionContent>
          <para>High Frequency band, 3-30 MHz. Used for long-range oceanic communications</para>
        </definitionContent>
      </definitionSpec>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D003"/>
        <definitionTerm>UHF Band</definitionTerm>
        <definitionContent>
          <para>Ultra High Frequency band, 300 MHz - 3 GHz. Used for military and satellite communications</para>
        </definitionContent>
      </definitionSpec>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D004"/>
        <definitionTerm>L-Band</definitionTerm>
        <definitionContent>
          <para>1-2 GHz frequency range. Used for SATCOM and GPS</para>
        </definitionContent>
      </definitionSpec>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D005"/>
        <definitionTerm>Guard Frequency</definitionTerm>
        <definitionContent>
          <para>Emergency frequency 121.5 MHz (VHF) or 243.0 MHz (UHF) monitored continuously</para>
        </definitionContent>
      </definitionSpec>
      <definitionSpec>
        <definitionIdent definitionIdentNumber="D006"/>
        <definitionTerm>Channel Spacing</definitionTerm>
        <definitionContent>
          <para>Frequency separation between adjacent channels, typically 8.33 kHz or 25 kHz for VHF COM</para>
        </definitionContent>
      </definitionSpec>
    </definitionRepository>
