{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Q100-61-TPL-JSON-CONFIG.schema.json",
  "title": "Configuration Data Schema",
  "description": "JSON Schema for validating configuration data",
  "type": "object",
  "required": ["config_id", "revision", "title"],
  "properties": {
    "config_id": {
      "type": "string",
      "pattern": "^Q100-61-CFG-[0-9]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Development", "Functional", "Allocated", "Product"]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "milestone": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ci_number"],
        "properties": {
          "ci_number": { "type": "string" },
          "ci_name": { "type": "string" },
          "revision": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["Baseline", "Changed", "Pending"]
          }
        }
      }
    },
    "effectivity": {
      "type": "object",
      "properties": {
        "aircraft_model": { "type": "string" },
        "serial_range": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        }
      }
    }
  }
}
