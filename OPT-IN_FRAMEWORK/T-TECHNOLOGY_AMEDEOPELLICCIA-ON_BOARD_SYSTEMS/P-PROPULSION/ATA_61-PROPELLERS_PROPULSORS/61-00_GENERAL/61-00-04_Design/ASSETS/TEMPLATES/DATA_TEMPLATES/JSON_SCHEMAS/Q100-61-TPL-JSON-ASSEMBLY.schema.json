{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Q100-61-TPL-JSON-ASSEMBLY.schema.json",
  "title": "Assembly Data Schema",
  "description": "JSON Schema for validating assembly data",
  "type": "object",
  "required": ["assembly_number", "revision", "title", "components"],
  "properties": {
    "assembly_number": {
      "type": "string",
      "pattern": "^Q100-61-ASSY-[0-9]+$",
      "description": "Unique assembly identifier"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": ["Top", "Sub", "Detail"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part_number", "quantity"],
        "properties": {
          "find_number": { "type": "integer", "minimum": 1 },
          "part_number": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "item_type": { 
            "type": "string",
            "enum": ["Part", "Assembly", "Standard"]
          }
        }
      }
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "enum": ["kg", "g", "lb"] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Released", "Obsolete"]
    }
  }
}
