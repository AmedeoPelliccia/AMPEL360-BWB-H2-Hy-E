{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ampel360.aero/schemas/dpp_export/v0.1/software_bom.json",
  "title": "Software Bill of Materials",
  "description": "Software Bill of Materials (SBOM) for avionics and embedded software systems on the aircraft",
  "type": "object",
  "required": [
    "sbom_id",
    "sbom_version",
    "aircraft_model",
    "baseline_id",
    "software_components"
  ],
  "properties": {
    "sbom_id": {
      "type": "string",
      "description": "Unique identifier for this Software BOM",
      "minLength": 1,
      "examples": ["SBOM-Q100-SW-2025-001"]
    },
    "sbom_version": {
      "type": "string",
      "description": "Version of this SBOM (semantic versioning)",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "examples": ["1.0", "1.0.0"]
    },
    "aircraft_model": {
      "type": "string",
      "description": "Aircraft model designation",
      "minLength": 1,
      "examples": ["AMPEL360-Q100"]
    },
    "baseline_id": {
      "type": "string",
      "description": "Reference to the baseline configuration",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this SBOM was created (ISO 8601)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this software BOM"
    },
    "software_components": {
      "type": "array",
      "description": "List of software components installed on the aircraft",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "name",
          "version",
          "supplier",
          "ata_chapter"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "description": "Unique identifier for this software component",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Software component name",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "description": "Software version (semantic versioning recommended)",
            "minLength": 1
          },
          "part_number": {
            "type": "string",
            "description": "Software part number",
            "pattern": "^[A-Z0-9\\-_.]+$"
          },
          "description": {
            "type": "string",
            "description": "Description of the software component"
          },
          "supplier": {
            "type": "string",
            "description": "Software supplier/vendor name",
            "minLength": 1
          },
          "ata_chapter": {
            "type": "string",
            "description": "ATA iSpec 2200 chapter/section",
            "pattern": "^\\d{2}(-\\d{2})?(-\\d{2})?$"
          },
          "certification_level": {
            "type": "string",
            "description": "DO-178C Design Assurance Level",
            "enum": ["DAL-A", "DAL-B", "DAL-C", "DAL-D", "DAL-E", "N/A"]
          },
          "binary_files": {
            "type": "array",
            "description": "List of binary executable files",
            "items": {
              "type": "object",
              "required": ["filename", "checksum"],
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Filename (basename only, no path separators)",
                  "minLength": 1,
                  "pattern": "^[^/\\\\]+$"
                },
                "checksum": {
                  "type": "string",
                  "description": "SHA-256 checksum (hex format)",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "description": "File size in bytes",
                  "minimum": 0
                },
                "load_address": {
                  "type": "string",
                  "description": "Memory load address (hex format)",
                  "pattern": "^0x[0-9a-fA-F]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "configuration_files": {
            "type": "array",
            "description": "List of configuration data files",
            "items": {
              "type": "object",
              "required": ["filename", "checksum"],
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Filename (basename only, no path separators)",
                  "minLength": 1,
                  "pattern": "^[^/\\\\]+$"
                },
                "checksum": {
                  "type": "string",
                  "description": "SHA-256 checksum (hex format)",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "description": "File size in bytes",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "dependencies": {
            "type": "array",
            "description": "List of dependencies (other software component IDs)",
            "items": {
              "type": "string",
              "description": "Reference to another component_id"
            }
          },
          "target_hardware": {
            "type": "string",
            "description": "Target hardware platform",
            "examples": ["ARM Cortex-M7", "PowerPC MPC5777M", "Intel x86-64"]
          },
          "license": {
            "type": "string",
            "description": "Software license",
            "examples": ["Proprietary", "Apache-2.0", "GPL-3.0", "Commercial"]
          },
          "safety_critical": {
            "type": "boolean",
            "description": "Whether this is safety-critical software"
          },
          "verification_status": {
            "type": "string",
            "description": "Verification and validation status",
            "enum": ["not_started", "in_progress", "verified", "certified"]
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or comments"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the software BOM",
      "properties": {
        "total_components": {
          "type": "integer",
          "description": "Total count of software components",
          "minimum": 0
        },
        "total_size_mb": {
          "type": "number",
          "description": "Total size of all software in megabytes",
          "minimum": 0
        },
        "certification_basis": {
          "type": "array",
          "description": "Certification standards applicable to software",
          "items": {
            "type": "string",
            "examples": ["DO-178C", "DO-254", "DO-326A", "ED-202A"]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
